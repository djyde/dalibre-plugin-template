{
  "$schema": "./plugin.schema.json",
  "id": "com.example.my-plugin",
  "name": "My plugin",
  "version": "0.1.0",
  "api": 1,
  "description": "Books from example.com",
  "author": "",
  "license": "MIT",
  "icon": "globe",
  "capabilities": {
    "bookSource": {
      "filters": [
        {
          "key": "language", "title": "Language", "type": "language",
          "options": [{ "value": "", "title": "Any language" }, { "value": "en" }, { "value": "fr" }]
        }
      ]
    }
  },
  "permissions": {
    "hosts": ["api.example.com"]
  },
  "settings": [
    { "key": "apiKey", "title": "API key", "type": "secret", "description": "From your account page on example.com." }
  ]
}
